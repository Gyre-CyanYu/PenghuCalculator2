.memberScroll {
  height: 20vh;
  z-index: 1;
  background: var(--td-bg-color-container);
  box-shadow: var(--shadow);
  white-space: nowrap;
}
.memberScrollCard {
  display: inline-flex;
  height: 100%;
}
.image {
  width: 100%;
  height: 100%;
}

.actionScroll {
  max-height: calc(80vh - 175rpx);
}
.actionScrollCard {
  margin: 32rpx;
}

.footer {
  margin-top: 32rpx;
}

.fabWrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--td-brand-color);
  border-radius: 48rpx;
}

.keyboard {
  background: var(--td-bg-color-container);
  padding: 32rpx;
  border-radius: 24rpx 24rpx 0 0;
}
.keyboardSelector {
  white-space: nowrap;
}
.nickname {
  color: var(--td-bg-color-container);
}
.keyboardHeader {
  display: flex;
  justify-content: space-between;
}
.keyboardBody {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(4, 1fr);
  gap: 12rpx;
  height: 32vh;
}
.switchKey {
  grid-column: 4 / 5;
  grid-row: 1 / 2;
  --td-button-medium-height: 100%;
}
.confirmKey {
  grid-column: 4 / 5;
  grid-row: 2 / 4;
  --td-button-medium-height: 100%;
}
.closeKey {
  grid-column: 4 / 5;
  grid-row: 4 / 5;
  --td-button-medium-height: 100%;
}
.backspaceKey {
  grid-column: 2 / 4;
  grid-row: 4 / 5;
  --td-button-medium-height: 100%;
}
.key {
  grid-column: span 1;
  grid-row: span 1;
  --td-button-medium-height: 100%;
}
.wideKey {
  grid-column: span 3;
  grid-row: span 1;
  --td-button-medium-height: 100%;
}