function calculateBackerDataColumn(backerDataListLength) {
  var row = Math.ceil(backerDataListLength / 4)
  var column = Math.ceil(backerDataListLength / row)
  
  return column
}

function calculateSelectorColumn(isNextPlayer, nextPlayerDataTuple, nextDealer) {
  var column = 0;

  nextPlayerDataTuple.forEach(function(nextPlayerData) {
    if (nextPlayerData.openid && (!isNextPlayer || nextPlayerData.openid !== nextDealer)) {
      column++
    };
  });

  return column
}

module.exports = {
  calculateBackerDataColumn: calculateBackerDataColumn,
  calculateSelectorColumn: calculateSelectorColumn
};