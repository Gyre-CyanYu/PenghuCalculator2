.seatWrapper {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
}

.playerGridWrapper {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  width: 100%;
  aspect-ratio: 1;
}

.playerWrapper {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.backerWrapper {
  display: flex;
}
.backerWrapper4 {
  border-bottom: 3rpx solid rgb(0, 82, 217, 0.1);
  justify-content: flex-start;
  align-items: flex-start;
}
.backerWrapper5 {
  border-right: 3rpx solid rgb(0, 82, 217, 0.1);
  justify-content: flex-start;
  align-items: flex-end;
}
.backerWrapper6 {
  border-top: 3rpx solid rgb(0, 82, 217, 0.1);
  justify-content: flex-end;
  align-items: flex-end;
}
.backerWrapper7 {
  border-left: 3rpx solid rgb(0, 82, 217, 0.1);
  justify-content: flex-end;
  align-items: flex-start;
}

.seat {
  display: flex;
  justify-content: center;
  align-items: center;
  color: var(--td-error-color);
  font-size: large;
  font-weight: bold;
}
.seatC {
  grid-column: 2 / 3;
  grid-row: 2 / 3;
}
.seat0 {
  grid-column: 2 / 3;
  grid-row: 1 / 2;
}
.seat1 {
  grid-column: 1 / 2;
  grid-row: 2 / 3;
}
.seat2 {
  grid-column: 2 / 3;
  grid-row: 3 / 4;
}
.seat3 {
  grid-column: 3 / 4;
  grid-row: 2 / 3;
}

.buttonWrapper {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  width: 100%;
}
.randomBackButtonWrapper {
  display: flex;
  justify-content: center;
  align-items: center;
}
.rotateButtonWrapper {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.dataCard {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  margin: 16rpx 32rpx;
}
.dataGridWrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  width: 100%;
}
.dataWrapper {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  overflow: hidden
}

.roomid {
  color: var(--td-brand-color);
}
.time {
  color: var(--td-brand-color);
  font-size: large;
}
.unit {
  font-size: small;
  margin: 0 10rpx;
}
.gameConfigScroll {
  white-space: nowrap;
}
.gameConfigTag {
  margin: 0 8rpx;
}

.backerDataWrapper {
  display: grid;
  width: 100%;
  margin-top: 32rpx;
}