<wxs module="utils" src="./information.wxs" />

<view class="seatWrapper">
  <view class="playerGridWrapper">
    <view
      wx:for="{{seatDataList}}"
      wx:key="label"
      class="{{item.label < 0 ? 'playerGridWrapper' : item.label < 4 ? 'playerWrapper' : 'backerWrapper backerWrapper' + [index]}}"
    >
      <block wx:if="{{item.label < 0}}">
        <t-icon name="system-2" size="48rpx" color="var(--td-error-color)" t-class="seat seatC" />
        
        <view
          wx:if="{{seatItem.label > -1 && seatItem.label < 4}}"
          wx:for="{{seatDataList}}"
          wx:for-item="seatItem"
          wx:key="label"
          class="seat seat{{index}}"
        >{{seatItem.seat}}</view>
      </block>

      <block wx:elif="{{item.label < 4}}">
        <user
          wx:if="{{nextPlayerDataTuple[item.label].openid}}"
          avatarUrl="{{nextPlayerDataTuple[item.label].avatarUrl}}"
          nickname="{{nextPlayerDataTuple[item.label].nickname}}"
          badgeProps="{{ {count: nextPlayerDataTuple[item.label].openid === nextDealer ? '下局庄' : '', offset: [-6, 6]} }}"
        />

        <block wx:else>
          <t-button
            bind:tap="handleBePlayer"
            disabled="{{statusButtonDisabled}}"
            data-seat="{{item.label}}"
            theme="light"
            size="large"
            icon="user-add"
            shape="circle"
          />

          <view class="subtitle">点击加入</view>
        </block>
      </block>

      <user
        bind:tap="showBackerData"
        data-seat="{{item.label - 4}}"
        wx:elif="{{nextBackerDataMap[nextPlayerDataTuple[item.label - 4].openid].length}}"
        avatarUrl="{{nextBackerDataMap[nextPlayerDataTuple[item.label - 4].openid][0].avatarUrl}}"
        nickname="{{nextBackerDataMap[nextPlayerDataTuple[item.label - 4].openid][0].nickname}}"
        userGroupLength="{{nextBackerDataMap[nextPlayerDataTuple[item.label - 4].openid].length}}"
      />

    </view>
  </view>

  <view class="buttonGridWrapper">
    <view />

    <t-button wx:if="{{openid === nextDealer}}" bind:tap="showSelector" disabled="{{statusButtonDisabled}}" size="extra-small" content="转让" block />
    <t-button wx:elif="{{isNextPlayer}}" bind:tap="handleBeSpectator" disabled="{{statusButtonDisabled}}" size="extra-small" content="旁观" block />
    <t-button wx:else bind:tap="showSelector" disabled="{{statusButtonDisabled}}" size="extra-small" content="砸鸟" block />

    <view class="rotateButtonWrapper">
      <view><t-button
        bind:tap="handleRotate"
        data-offset="{{1}}"
        variant="text"
        shape="square"
        size="extra-small"
        icon="rollback"
      />

      <t-button
        bind:tap="handleRotate"
        data-offset="{{3}}"
        variant="text"
        shape="square"
        size="extra-small"
        icon="rollfront"
      />

      <t-button
        bind:tap="toggleDirectionLock"
        theme="{{directionLock ? 'danger' : ''}}"
        variant="text"
        shape="square"
        size="extra-small"
        icon="{{directionLock ? 'rotate-locked' : 'lock-off'}}"
      /></view>
    </view>
  </view>
</view>

<t-divider />

<view class="card dataCard">
  <view class="title">分享房间</view>

  <view class="dataGridWrapper">
    <view class="dataWrapper">
      <t-image
        src="{{qrCodeUrl}}"
        error="slot"
        style="height: 100%; aspect-ratio: 1"
        mode="heightFix"
        shape="round"
        show-menu-by-longpress
      >
        <view slot="error" class="content">无小程序码</view>
      </t-image>
    </view>

    <view class="dataWrapper">
      <view class="content">房间号</view>
      <view class="roomid">{{roomid}}</view>
      <t-button openType="share" content="分享" size="small" />
    </view>
  </view>
</view>

<view class="card dataCard">
  <view class="title">房间信息</view>

  <view class="dataGridWrapper">
    <view class="dataWrapper">
      <view class="content">剩余时间</view>
      <view wx:if="{{isGamePlaying === -1}}" class="time">房间已结算</view>
      <t-count-down wx:else time="{{remainTime < 0 ? 0 : remainTime}}" t-class-count="time" t-class-split="unit" splitWithUnit />
    </view>

    <view class="dataWrapper">
      <view class="content">规则设置</view>

      <scroll-view class="gameConfigScroll" scroll-x>
        <t-tag t-class="gameConfigTag" variant="light" size="large" theme="{{gameConfig.mode === 'addition' ? 'success' : 'primary'}}">{{gameConfig.mode === 'addition' ? '加法' : '乘法'}}</t-tag>
        <t-tag t-class="gameConfigTag" variant="light" size="large" theme="{{gameConfig.limit ? 'success' : 'primary'}}">{{gameConfig.limit ? gameConfig.limit + '倍' : '连中'}}</t-tag>
        <t-tag t-class="gameConfigTag" variant="light" size="large" theme="{{gameConfig.fiveTriWinConsiderHoldDealer ? 'success' : 'primary'}}">五福{{gameConfig.fiveTriWinConsiderHoldDealer ? '' : '不'}}考虑连庄</t-tag>
        <t-tag t-class="gameConfigTag" variant="light" size="large" theme="{{gameConfig.heavenWinConsiderHoldDealer ? 'success' : 'primary'}}">天胡{{gameConfig.heavenWinConsiderHoldDealer ? '' : '不'}}考虑连庄</t-tag>
      </scroll-view>
    </view>
  </view>
</view>

<view style="height: 176rpx;" />

<view class="tabButtonWrapper">
  <t-button wx:if="{{isGamePlaying !== -1}}" bind:tap="showSettle" content="结算" theme="danger" block />
  <t-button wx:else bind:tap="navigateToHistory" content="历史记录" theme="primary" block />
</view>

<t-dialog
  visible="{{settleVisible}}"
  title="结算房间"
  content="房间结算后将无法继续计分"
  confirm-btn="{{ { loading: settleButtonLoading, content: settleButtonLoading ? '结算中' : '结算', theme: 'danger' } }}"
  cancel-btn="{{ {disabled: settleButtonLoading, content: '取消', theme: 'default', variant: 'outline'} }}"
  bind:confirm=""
  bind:cancel="closeSettle"
/>

<t-dialog
  visible="{{selectorVisible}}"
  title="{{isNextPlayer ? '转让庄家' : '砸鸟'}}"
  content="{{isNextPlayer ? '请选择要转让的玩家' : isRandomBack ? '随机砸鸟目标下局开始后刷新' : selectedPlayer ? '不选择玩家可退出砸鸟' : '请选择要砸鸟的玩家'}}"
>
  <view slot="actions" class="selectorButtonWrapper">
    <t-button
      bind:tap="closeSelector"
      disabled="{{selectorButtonLoading || randomBackButtonLoading}}"
      content="取消"
      variant="outline"
      block
    />

    <t-button
      wx:if="{{isNextPlayer}}"
      bind:tap="handleTransferDealer"
      loading="{{selectorButtonLoading}}"
      content="{{selectorButtonLoading ? '转让中' : '转让'}}"
      theme="primary"
      block
    />

    <block wx:else>
      <t-button
        wx:if="{{!selectorButtonLoading}}"
        bind:tap="handleRandomBack"
        loading="{{randomBackButtonLoading}}"
        content="{{(isRandomBack ? '退出随机' : '随机砸鸟') + (randomBackButtonLoading ? '中' : '')}}"
        theme="{{isRandomBack ? 'primary' : 'light'}}"
        block
      />

      <t-button
        wx:if="{{!isRandomBack && !randomBackButtonLoading}}"
        bind:tap="handleBeBacker"
        loading="{{selectorButtonLoading}}"
        content="{{(selectedPlayer ? '砸鸟' : '退出砸鸟') + (selectorButtonLoading ? '中' : '')}}"
        theme="primary"
        block
      />
    </block>
  </view>

  <view
    style="grid-template-columns: repeat({{utils.calculateSelectorColumn(isNextPlayer, nextPlayerDataTuple, nextDealer)}}, 1fr);"
    class="dialogWrapper"
    slot="content"
  >
    <user
      bind:tap="handlePlayerSelect"
      data-seat="{{index}}"
      wx:if="{{item.openid && (!isNextPlayer || item.openid !== nextDealer)}}"
      wx:for="{{nextPlayerDataTuple}}"
      wx:key="openid"
      avatarUrl="{{item.avatarUrl}}"
      nickname="{{item.nickname}}"
      badgeProps="{{ {count: selectedPlayer === item.openid ? (isNextPlayer ? '转让' : '砸鸟') : '', offset: [-6, 6]} }}"
    />
  </view>
</t-dialog>

<t-dialog
  visible="{{backerDataVisible}}"
  title="砸鸟玩家"
  content="{{targetNickname}}"
  cancel-btn="{{ {content: '关闭', theme: 'default', variant: 'outline'} }}"
  bind:cancel="closeBackerData"
>
  <view
    style="grid-template-columns: repeat({{utils.calculateBackerDataColumn(backerDataList)}}, 1fr);"
    class="dialogWrapper"
    slot="content"
  >
    <user
      wx:for="{{backerDataList}}"
      wx:key="openid"
      avatarUrl="{{item.avatarUrl}}"
      nickname="{{item.nickname}}"
    />
  </view>
</t-dialog>