.wrapper {
  box-sizing: border-box;
  margin: 0 32rpx;
}
.informationWrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 40vh;
}
.buttonWrapper {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-gap: 16rpx;
}

.joinButton {
  grid-column: 1 / 3;
  grid-row: 1 / 5;
  --td-button-medium-font-size: 48rpx;
  --td-button-medium-height: 256rpx;
}
.createButton {
  grid-column: 3 / 5;
  grid-row: 1 / 4;
  --td-button-medium-font-size: 48rpx;
  --td-button-medium-height: 100%;
}
.noticeButton {
  grid-column: 3 / 5;
  grid-row: span 1;
  --td-button-medium-height: 100%;
}
.roomButton {
  grid-column: span 1;
  grid-row: span 1;
}

.noticeScroll {
  max-height: 40vh;
}
.noticeWrapper {
  margin: 32rpx 0;
}
.importantTime {
  color: var(--td-error-color);
}